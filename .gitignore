# =========================
# Java / Spring Boot (Maven)
# =========================

# Build outputs
target/
build/
out/
.gradle/
.maven/

# Compiled / packaged artifacts
*.class
*.jar
*.war
*.ear
*.nar

# Logs and runtime dumps
*.log
logs/
uploads/
hs_err_pid*
replay_pid*

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse / STS
.classpath
.project
.settings/
.apt_generated/
.factorypath
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/dist/
/.nb-gradle/

# VS Code
.vscode/

# Local env / secrets
.env
.env.*
.env.local
.env.*.local
!.env.example

# Keycloak local secrets
infra/keycloak/.env

# Keycloak diagnostic exports (never a backup, never versioned)
infra/keycloak/generated/

# Temporary/editor files
.tmp-log-metadata/
.workspace/
*.swp
*.swo
*~
*.tmp

# ==========================================
# Safety rules: NEVER ignore application code
# ==========================================
!src/main/java/
!src/main/java/**/
!src/main/java/**/*.java

# Estado local de Claude (agents, skills y templates se versionan)
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/routines/.state/
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/agent-registry.json
.claude/agent-memory-local/
.claude/assistant-daemon-state.json

# E2E local
target-e2e-*

# Python helper caches are generated artifacts, never source
**/__pycache__/
*.py[cod]
